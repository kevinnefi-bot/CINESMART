@model List<CINESMART.Models.Combo>

@{
    ViewData["Title"] = "Combos & Dulcería";
}

<section class="page-header">
    <div class="container text-center py-4">
        <span class="hero-badge">
            <i class="bi bi-cup-straw me-1"></i> DULCERÍA & SNACKS
        </span>
        <h1 class="hero-title">Combos de <span class="text-gold">Pipocas y Refrescos</span></h1>
        <p class="hero-description">Disfruta de nuestras mejores pipocas mantecosas y gaseosas heladas durante tu película.</p>
    </div>
</section>

<section class="container py-5">
    <div class="row g-4">
        @if (Model != null)
        {
            @foreach (var combo in Model)
            {
                <div class="col-md-4">
                    <div class="movie-card-modern shadow-lg h-100">
                        <div class="poster-wrapper position-relative" style="height: 240px;">
                            <img src="@combo.Imagen" alt="@combo.Nombre" class="movie-poster-img" style="object-fit: cover;" />
                            <span class="badge-rating position-absolute top-0 end-0 m-3 bg-success text-dark font-weight-bold fs-6">
                                Bs. @combo.Precio.ToString("F2")
                            </span>
                        </div>
                        <div class="movie-card-body p-4 d-flex flex-column">
                            <span class="genre-tag mb-1">
                                <i class="bi bi-star-fill me-1"></i> SNACK RECOMENDADO
                            </span>
                            <h3 class="movie-card-title text-light h4 font-weight-bold">@combo.Nombre</h3>
                            <p class="movie-card-desc text-muted mb-4 flex-grow-1">@combo.Descripcion</p>
                            
                            <a asp-controller="Home" asp-action="Comprar" class="btn-glow-gold py-2 px-3 fs-6 text-center border-0 text-dark font-weight-bold text-decoration-none rounded-3 mt-auto">
                                <i class="bi bi-ticket-detailed-fill me-1"></i> Comprar con Entradas
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</section>
