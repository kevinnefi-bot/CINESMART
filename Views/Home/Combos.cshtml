@model List<CINESMART.Models.Combo>

@{
    ViewData["Title"] = "Combos & Dulcería";
}

<section class="page-header">
    <div class="container text-center">
        <span class="hero-badge">🍿 DULCERÍA & SNACKS</span>
        <h1>Combos de Pipocas y Refrescos</h1>
        <p>Disfruta de nuestras mejores pipocas mantecosas y gaseosas heladas durante tu película.</p>
    </div>
</section>

<section class="container py-5">
    <div class="row g-4">
        @if (Model != null)
        {
            @foreach (var combo in Model)
            {
                <div class="col-md-4">
                    <div class="combo-card">
                        <div class="combo-img-wrapper mb-3 rounded-4 overflow-hidden" style="height: 220px; background: #000;">
                            <img src="@combo.Imagen" alt="@combo.Nombre" class="img-fluid w-100 h-100" style="object-fit: cover;" />
                        </div>
                        <h3 class="combo-title text-gold">@combo.Nombre</h3>
                        <p class="combo-desc text-light opacity-90">@combo.Descripcion</p>
                        <div class="combo-price-tag text-success">
                            Bs. @combo.Precio.ToString("F2")
                        </div>
                        <a asp-controller="Home" asp-action="Comprar" class="btn-combo-add mt-3">
                            🎟️ Comprar con Entradas
                        </a>
                    </div>
                </div>
            }
        }
    </div>
</section>
