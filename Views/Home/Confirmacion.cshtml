@model CINESMART.Models.Compra

@{
    ViewData["Title"] = "Boleto Confirmado - " + Model.CodigoReserva;
}

<section class="page-header">
    <div class="container text-center">
        <span class="hero-badge">🎉 COMPRA COMPLETADA</span>
        <h1>¡Disfruta tu Película!</h1>
        <p>Tu boleto ha sido generado con éxito. Presenta el código QR al ingresar a la sala.</p>
    </div>
</section>

<section class="container py-5">
    <div class="ticket-card-container">
        <div class="ticket-card">
            <!-- Ticket Header -->
            <div class="ticket-header">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="ticket-brand">🎬 CINESMART TICKET</span>
                    <span class="ticket-code">@Model.CodigoReserva</span>
                </div>
            </div>

            <!-- Ticket Body -->
            <div class="ticket-body">
                <div class="row g-4 align-items-center">
                    <div class="col-md-8">
                        <h2 class="ticket-movie-title text-gold">@Model.Pelicula</h2>
                        <div class="ticket-details-grid mt-3">
                            <div class="detail-item">
                                <span class="label">Comprador:</span>
                                <span class="value text-light">@Model.Cliente</span>
                            </div>
                            <div class="detail-item">
                                <span class="label">Correo:</span>
                                <span class="value text-light">@Model.Correo</span>
                            </div>
                            <div class="detail-item">
                                <span class="label">Fecha y Hora:</span>
                                <span class="value text-gold">📅 @Model.Fecha - 🕒 @Model.Hora</span>
                            </div>
                            <div class="detail-item">
                                <span class="label">Sala:</span>
                                <span class="value text-light">📍 @Model.Sala</span>
                            </div>
                            <div class="detail-item">
                                <span class="label">Entradas:</span>
                                <span class="value text-light">🎟️ @Model.CantidadEntradas entrada(s)</span>
                            </div>
                            <div class="detail-item">
                                <span class="label">Asientos:</span>
                                <span class="value text-gold">💺 @(Model.Asientos != null && Model.Asientos.Any() ? string.Join(", ", Model.Asientos) : "General / En sala")</span>
                            </div>
                            <div class="detail-item">
                                <span class="label">Combo Snacking:</span>
                                <span class="value text-light">🍿 @Model.ComboNombre</span>
                            </div>
                            <div class="detail-item">
                                <span class="label">Total Pagado:</span>
                                <span class="value text-success font-weight-bold fs-4">Bs. @Model.Total.ToString("F2")</span>
                            </div>
                        </div>
                    </div>

                    <!-- Código QR estilizado -->
                    <div class="col-md-4 text-center">
                        <div class="qr-wrapper p-3 rounded-4 bg-white d-inline-block shadow-lg">
                            <img src="~/images/qr_code.svg" alt="Código QR" style="width: 140px; height: 140px;" />
                            <div class="text-dark font-weight-bold small mt-2">@Model.CodigoReserva</div>
                        </div>
                        <p class="text-muted small mt-2">Muestra este QR al ingresar a la sala</p>
                    </div>
                </div>
            </div>

            <!-- Ticket Footer Buttons -->
            <div class="ticket-footer d-flex justify-content-between align-items-center">
                <button onclick="window.print()" class="btn-print">
                    🖨️ Imprimir / Guardar PDF
                </button>
                <a asp-controller="Home" asp-action="Cartelera" class="btn-back">
                    🎬 Volver a la Cartelera
                </a>
            </div>
        </div>
    </div>
</section>
