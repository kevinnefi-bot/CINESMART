@model List<CINESMART.Models.Pelicula>

@{
    ViewData["Title"] = "El Cine Comienza Aquí";
}

<section class="hero-banner">
    <div class="hero-overlay"></div>
    <div class="container hero-content text-center">
        <span class="hero-badge">🍿 ESTRENOS 2026</span>
        <h1 class="hero-title">Vive la Magia del Cine en <span class="text-gold">CINESMART</span></h1>
        <p class="hero-description">
            Elige tu película preferida, selecciona tus asientos e incluye tus combos de dulcería favoritos.
        </p>
        <div class="hero-buttons">
            <a asp-controller="Home" asp-action="Cartelera" class="btn-glow-gold">
                🎬 Ver Cartelera Completa
            </a>
            <a asp-controller="Home" asp-action="Combos" class="btn-glass">
                🍿 Ver Combos
            </a>
        </div>
    </div>
</section>

<!-- Películas Destacadas (Hacer clic en la tarjeta navega a Detalles) -->
<section class="featured-section container py-5">
    <div class="section-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="sub-title">EN PANTALLA GRANDE</span>
            <h2 class="section-title">Películas Destacadas</h2>
        </div>
        <a asp-controller="Home" asp-action="Cartelera" class="view-all-link">Ver todas las películas &rarr;</a>
    </div>

    <div class="row g-4">
        @if (Model != null)
        {
            @foreach (var pelicula in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <!-- Al hacer clic en cualquier parte de la tarjeta se entra al subprograma de Detalles -->
                    <a asp-controller="Home" asp-action="Detalles" asp-route-id="@pelicula.Id" class="movie-card-link text-decoration-none">
                        <div class="movie-card-modern">
                            <div class="poster-wrapper">
                                <img src="@pelicula.Imagen" alt="@pelicula.Titulo" class="movie-poster-img" />
                                <span class="badge-rating">⭐ @pelicula.Calificacion</span>
                                <span class="badge-duration">⏱️ @pelicula.Duracion</span>
                            </div>
                            <div class="movie-card-body">
                                <span class="genre-tag">@pelicula.Genero</span>
                                <h3 class="movie-card-title text-light">@pelicula.Titulo</h3>
                                <p class="movie-card-desc">@pelicula.Descripcion</p>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <span class="text-gold font-weight-bold">Ver Detalles &rarr;</span>
                                    <span class="btn-card-buy-sm">🎟️ Comprar</span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        }
    </div>
</section>

<!-- Sección de Beneficios -->
<section class="features-section py-5">
    <div class="container">
        <div class="text-center mb-5">
            <span class="sub-title">EXPERIENCIA CINESMART</span>
            <h2 class="section-title">¿Cómo funciona?</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-box">
                    <div class="feature-icon-wrapper">🎬</div>
                    <h4>1. Elige tu Película</h4>
                    <p>Explora la cartelera y conoce la sinopsis completa y elenco de cada película.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-box">
                    <div class="feature-icon-wrapper">💺</div>
                    <h4>2. Selecciona Asientos</h4>
                    <p>Escoge tu horario y selecciona tus asientos preferidos en tiempo real.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-box">
                    <div class="feature-icon-wrapper">🍿</div>
                    <h4>3. Agrega tus Combos</h4>
                    <p>Acompaña tu boleto con combos individuales, en pareja o familiares.</p>
                </div>
            </div>
        </div>
    </div>
</section>